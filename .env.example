# Supabase (remoto — projeto auto-check-araujo)
NUXT_PUBLIC_SUPABASE_URL=https://afvtakijrfalpdtmbjdt.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=sua-anon-key-aqui

# Service role — apenas no servidor (convite de colaboradores). Nunca expor no cliente.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Alias também aceitos pelo módulo @nuxtjs/supabase:
# SUPABASE_URL=
# SUPABASE_KEY=

# Comandos de voz (IA gratuita). Groq primeiro; Gemini se o Groq falhar ou atingir o limite.
# Sem nenhuma chave, a voz usa o parser local de palavras-chave.
# https://console.groq.com/keys
NUXT_GROQ_API_KEY=
# https://aistudio.google.com/apikey
NUXT_GEMINI_API_KEY=
# Opcional: trocar modelos sem mexer no código
# NUXT_GROQ_MODEL=openai/gpt-oss-120b
# NUXT_GEMINI_MODEL=gemini-3.8-flash
