{"nodes": [{"id": "_cursor_skills_improve_animations_audit_animation_audit_playbook", "label": "Animation Audit Playbook", "file_type": "document", "source_file": ".cursor/skills/improve-animations/AUDIT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eight audit categories with exact target values distilled from Emil Kowalski's design engineering philosophy; never approximate listed values."}, {"id": "_cursor_skills_improve_animations_audit_purpose_and_frequency", "label": "Purpose & Frequency", "file_type": "rationale", "source_file": ".cursor/skills/improve-animations/AUDIT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every animation must answer why it animates; 100+/day actions get no animation; strongest fix is often delete."}, {"id": "_cursor_skills_improve_animations_audit_easing_and_duration", "label": "Easing & Duration", "file_type": "rationale", "source_file": ".cursor/skills/improve-animations/AUDIT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ease-out for enter/exit; ease-in-out for on-screen move; ease-in on UI is always a finding; UI under 300ms."}, {"id": "_cursor_skills_improve_animations_audit_ease_out_token", "label": "--ease-out cubic-bezier Token", "file_type": "concept", "source_file": ".cursor/skills/improve-animations/AUDIT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "cubic-bezier(0.23, 1, 0.32, 1) \u2014 strong ease-out for UI."}, {"id": "_cursor_skills_improve_animations_audit_physicality_and_origin", "label": "Physicality & Origin", "file_type": "rationale", "source_file": ".cursor/skills/improve-animations/AUDIT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never scale(0); use scale(0.9\u20130.97)+opacity; popovers scale from trigger; modals exempt with center origin."}, {"id": "_cursor_skills_improve_animations_audit_interruptibility", "label": "Interruptibility", "file_type": "rationale", "source_file": ".cursor/skills/improve-animations/AUDIT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transitions retarget mid-flight; keyframes restart; use springs for gesture-driven motion."}, {"id": "_cursor_skills_improve_animations_audit_performance", "label": "Animation Performance", "file_type": "rationale", "source_file": ".cursor/skills/improve-animations/AUDIT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Animate transform and opacity only; transition:all is always a finding; Framer x/y/scale shorthands not GPU-accelerated."}, {"id": "_cursor_skills_improve_animations_audit_accessibility", "label": "Animation Accessibility", "file_type": "rationale", "source_file": ".cursor/skills/improve-animations/AUDIT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "prefers-reduced-motion means fewer/gentler animations not zero; gate hover with (hover:hover) and (pointer:fine)."}, {"id": "_cursor_skills_improve_animations_audit_cohesion_and_tokens", "label": "Cohesion & Tokens", "file_type": "rationale", "source_file": ".cursor/skills/improve-animations/AUDIT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Motion matches product personality; share easing/duration tokens; 30\u201380ms stagger never blocks interaction."}, {"id": "_cursor_skills_improve_animations_audit_missed_opportunities", "label": "Missed Opportunities", "file_type": "rationale", "source_file": ".cursor/skills/improve-animations/AUDIT.md", "source_location": null, "source_url": nu